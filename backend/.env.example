# Supabase
# SUPABASE_URLはJWT検証用のJWKSエンドポイント（<url>/auth/v1/.well-known/jwks.json）取得にも使う
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# Database (SQLAlchemy用。直接接続ではなくSession Poolerの接続文字列を使うこと。
# Supabaseダッシュボード「Connect」→「Session pooler」からコピーする。
# 直接接続用の db.<ref>.supabase.co ホスト名は名前解決できないことがある)
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-your-region.pooler.supabase.com:5432/postgres

# 認証はSupabase Auth（Google OAuth）+ JWKS経由のJWT検証（backend/app/core/security.py）を使用しており、
# SECRET_KEYは現状どのコードからも参照されていない（将来自前でトークンを発行する場合のための予約）
SECRET_KEY=change-me-to-a-long-random-string

# CORS — comma-separated origins
CORS_ORIGINS=["http://localhost:3000"]

# App
DEBUG=true

# Gemini API (AI subdivision)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemma-4-31b-it
