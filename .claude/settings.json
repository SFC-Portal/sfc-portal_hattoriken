{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npx *)",
      "Bash(pip install *)",
      "Bash(uvicorn *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(cat *)",
      "Read(*)",
      "Write(frontend/src/**)",
      "Write(backend/app/**)",
      "Edit(frontend/src/**)",
      "Edit(backend/app/**)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(**/*.env)"
    ]
  },
  "env": {
    "NODE_ENV": "development"
  }
}
